# Variables d'environnement — dtmini-portfolio
# Copier ce fichier en .env et adapter les valeurs (aucune valeur réelle ici)

# Serveur
PORT=3100
NODE_ENV=production

# Contact (via Resend)
# Adresse de réception du formulaire (destinataire)
CONTACT_EMAIL=
# Adresse d'envoi (doit être un domaine vérifié dans Resend)
CONTACT_FROM=
# Clé API Resend
RESEND_API_KEY=
